{
  "name": "@office-view-suite/viewer-pdf",
  "version": "0.2.0",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node ../../scripts/prepare-sdk-assets.mjs pdf && vite build && tsc -p tsconfig.build.json && node ../../scripts/collect-sdk-notices.mjs pdf",
    "typecheck": "tsc --noEmit",
    "wasm": "node ../../scripts/build-wasm.mjs pdf"
  },
  "dependencies": {
    "@office-view-suite/viewer-core": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
