{
  "name": "office-view-suite",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@7.33.7",
  "scripts": {
    "dev:ppt": "pnpm build:sdk && pnpm --filter ppt-view dev",
    "dev:word": "pnpm build:sdk && pnpm --filter word-view dev",
    "dev:excel": "pnpm build:sdk && pnpm --filter excel-view dev",
    "dev:pdf": "pnpm build:sdk && pnpm --filter pdf-view dev",
    "dev:sdk": "pnpm build:sdk && pnpm --filter office-view-suite-vanilla-fixture dev",
    "build:sdk": "pnpm --filter '@office-view-suite/*' --workspace-concurrency=1 build",
    "build": "pnpm --workspace-concurrency=1 --recursive run build",
    "build:ppt": "pnpm --filter ppt-view... --workspace-concurrency=1 build",
    "build:word": "pnpm --filter word-view... --workspace-concurrency=1 build",
    "build:excel": "pnpm --filter excel-view... --workspace-concurrency=1 build",
    "build:pdf": "pnpm --filter pdf-view... --workspace-concurrency=1 build",
    "test": "node --test tests/*.mjs",
    "test:packages": "node scripts/verify-packed-sdk.mjs",
    "test:browser": "node scripts/browser-sdk-smoke.mjs",
    "test:visual": "node scripts/visual-sdk-regression.mjs",
    "verify:pdfium": "node scripts/verify-pdfium-notices.mjs",
    "typecheck": "pnpm --workspace-concurrency=1 --recursive run typecheck",
    "typecheck:ppt": "pnpm --filter ppt-view typecheck",
    "typecheck:word": "pnpm --filter word-view typecheck",
    "typecheck:excel": "pnpm --filter excel-view typecheck",
    "typecheck:pdf": "pnpm --filter pdf-view typecheck",
    "wasm": "pnpm --filter './apps/*' --workspace-concurrency=1 --recursive run wasm",
    "wasm:ppt": "pnpm --filter ppt-view wasm",
    "wasm:word": "pnpm --filter word-view wasm",
    "wasm:excel": "pnpm --filter excel-view wasm",
    "wasm:pdf": "pnpm --filter pdf-view wasm"
  }
}
