{
  "name": "office-view-suite",
  "private": true,
  "version": "0.1.0",
  "license": "Apache-2.0",
  "packageManager": "pnpm@7.33.7",
  "scripts": {
    "dev:ppt": "pnpm build:sdk && pnpm --filter ppt-view dev",
    "dev:word": "pnpm build:sdk && pnpm --filter word-view dev",
    "dev:excel": "pnpm build:sdk && pnpm --filter excel-view dev",
    "dev:pdf": "pnpm build:sdk && pnpm --filter pdf-view dev",
    "dev:sdk": "pnpm build:sdk && pnpm --filter office-view-suite-vanilla-fixture dev",
    "dev:vue2": "pnpm build:sdk && pnpm --filter office-view-suite-vue2-fixture dev",
    "build:sdk": "pnpm --filter '@office-view-suite/*' --workspace-concurrency=1 build",
    "build": "pnpm --workspace-concurrency=1 --recursive run build",
    "build:ppt": "pnpm --filter ppt-view... --workspace-concurrency=1 build",
    "build:word": "pnpm --filter word-view... --workspace-concurrency=1 build",
    "build:excel": "pnpm --filter excel-view... --workspace-concurrency=1 build",
    "build:pdf": "pnpm --filter pdf-view... --workspace-concurrency=1 build",
    "test": "node --test tests/*.mjs",
    "test:rust": "cargo test --locked --manifest-path packages/viewer-word/rs/Cargo.toml && cargo test --locked --manifest-path packages/viewer-excel/rs/Cargo.toml && cargo test --locked --manifest-path packages/viewer-ppt/rs/Cargo.toml",
    "test:packages": "node scripts/verify-packed-sdk.mjs",
    "test:browser": "node scripts/browser-sdk-smoke.mjs",
    "test:watermark": "node scripts/browser-watermark-smoke.mjs",
    "test:watermark:layout": "node scripts/verify-watermark-layout.mjs",
    "test:vue2": "node scripts/verify-vue2-sdk.mjs",
    "test:attachment": "node scripts/verify-attachment-watermark.mjs",
    "test:visual": "node scripts/visual-sdk-regression.mjs",
    "test:excel": "node scripts/excel-preview-regression.mjs",
    "test:word": "node scripts/word-pagination-regression.mjs",
    "test:word:tables": "node scripts/word-table-regression.mjs",
    "test:word:tabs": "node scripts/word-tabs-regression.mjs",
    "test:word:display": "node scripts/word-display-regression.mjs",
    "test:word:charts": "node scripts/word-chart-regression.mjs",
    "test:ppt:display": "node scripts/ppt-display-regression.mjs",
    "verify:pdfium": "node scripts/verify-pdfium-notices.mjs",
    "typecheck": "pnpm --workspace-concurrency=1 --recursive run typecheck",
    "typecheck:ppt": "pnpm --filter ppt-view typecheck",
    "typecheck:word": "pnpm --filter word-view typecheck",
    "typecheck:excel": "pnpm --filter excel-view typecheck",
    "typecheck:pdf": "pnpm --filter pdf-view typecheck",
    "wasm": "pnpm --filter '@office-view-suite/*' --workspace-concurrency=1 --recursive run wasm",
    "wasm:ppt": "pnpm --filter @office-view-suite/viewer-ppt wasm",
    "wasm:word": "pnpm --filter @office-view-suite/viewer-word wasm",
    "wasm:excel": "pnpm --filter @office-view-suite/viewer-excel wasm",
    "wasm:pdf": "pnpm --filter @office-view-suite/viewer-pdf wasm"
  }
}
